        "name": "invoke_custom_py_code",
        "as": "bd7ab94b",
        "keyword": "action",
        "input": {
          "payload_asset_type": "inline",
          "code": "import json\nimport base64\nimport binascii\n\n\ndef main(input):\n    encoded_data = input.get(\"encoded_data\")\n\n    if not encoded_data:\n        raise ValueError(\"Encoded data is required.\")\n\n    try:\n        decoded_bytes = base64.b64decode(\n            encoded_data,\n            validate=True\n        )\n\n        payload = json.loads(\n            decoded_bytes.decode(\"utf-8\")\n        )\n\n    except (\n        ValueError,\n        UnicodeDecodeError,\n        binascii.Error\n    ) as exc:\n        raise ValueError(\n            \"Invalid Base64-encoded JSON payload.\"\n        ) from exc\n\n    if not isinstance(payload, dict):\n        raise ValueError(\n            \"Decoded payload must be a JSON object.\"\n        )\n\n    return {\n        \"valid\": True,\n        \"customer_id\": payload.get(\"customer_id\"),\n        \"customer_name\": payload.get(\"name\"),\n        \"status\": payload.get(\"status\")\n    }\n",
          "name": "Decode and Validate Base64 Payload",
          "code_input": {
            "schema": "[{\"control_type\":\"text\",\"label\":\"Encoded Data\",\"name\":\"encoded_data\",\"type\":\"string\",\"optional\":false,\"parent\":[\"code_input\",\"data\"]}]",
