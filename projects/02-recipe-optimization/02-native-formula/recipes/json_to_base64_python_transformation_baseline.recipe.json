        "name": "invoke_custom_py_code",
        "as": "b214c76b",
        "keyword": "action",
        "input": {
          "payload_asset_type": "inline",
          "code": "\n\"\"\"\nProject: Workato Recipe Optimization\nAuthor: Mina Akbari\nStep: Serialize JSON and Encode Base64\n\nDescription:\n    Validates customer data, converts it to JSON,\n    and encodes it as Base64.\n\nPurpose:\n    Baseline implementation demonstrating a Python\n    action that can be replaced by Workato's native\n    Payload.to_json.encode_base64 formula.\n\"\"\"\n\nimport json\nimport base64\n\n\ndef main(input):\n    # Retrieve and validate the payload\n    payload = input.get(\"payload\")\n\n    if not isinstance(payload, dict):\n        raise ValueError(\"Payload must be a JSON object.\")\n\n    # Validate required fields\n    required_fields = (\n        \"customer_id\", \"name\", \"email\", \"status\"\n    )\n\n    for field in required_fields:\n        if field not in payload or payload[field] is None:\n            raise ValueError(f\"Missing required field: {field}\")\n\n    # Serialize JSON and encode as Base64\n    json_string = json.dumps(\n        payload,\n        ensure_ascii=False,\n        separators=(\",\", \":\")\n    )\n\n    encoded_payload = base64.b64encode(\n        json_string.encode(\"utf-8\")\n    ).decode(\"ascii\")\n\n    # Return encoded result\n    return {\"encoded_payload\": encoded_payload}",
          "code_output_schema_json": "[{\"control_type\":\"text\",\"label\":\"Encoded payload\",\"optional\":true,\"type\":\"string\",\"name\":\"encoded_payload\"}]",
          "code_input": {
            "schema": "[{\"properties\":[{\"control_type\":\"number\",\"label\":\"Customer ID\",\"parse_output\":\"integer_conversion\",\"name\":\"customer_id\",\"type\":\"integer\",\"render_input\":\"integer_conversion\",\"parent\":[\"code_input\",\"data\",\"payload\"]},{\"control_type\":\"text\",\"label\":\"Name\",\"name\":\"name\",\"type\":\"string\",\"parent\":[\"code_input\",\"data\",\"payload\"]},{\"control_type\":\"text\",\"label\":\"Email\",\"name\":\"email\",\"type\":\"string\",\"parent\":[\"code_input\",\"data\",\"payload\"]},{\"control_type\":\"text\",\"label\":\"Status\",\"name\":\"status\",\"type\":\"string\",\"parent\":[\"code_input\",\"data\",\"payload\"]}],\"label\":\"Payload\",\"name\":\"payload\",\"type\":\"object\",\"optional\":false,\"parent\":[\"code_input\",\"data\"]}]",
            "data": {
              "payload": {
                "customer_id": "#{_dp('{\"pill_type\":\"output\",\"provider\":\"workato_webhooks\",\"line\":\"6616e4bd\",\"path\":[\"payload\",\"customer_id\"]}')}",
                "name": "#{_dp('{\"pill_type\":\"output\",\"provider\":\"workato_webhooks\",\"line\":\"6616e4bd\",\"path\":[\"payload\",\"name\"]}')}",
                "email": "#{_dp('{\"pill_type\":\"output\",\"provider\":\"workato_webhooks\",\"line\":\"6616e4bd\",\"path\":[\"payload\",\"email\"]}')}",
                "status": "#{_dp('{\"pill_type\":\"output\",\"provider\":\"workato_webhooks\",\"line\":\"6616e4bd\",\"path\":[\"payload\",\"status\"]}')}"
              }
            }
          },
